# Maintainer: 0x07dc <voss.jamil@gmail.com>
pkgname=airplane-game-git
pkgver=0.1.1.r22.g957de16
pkgrel=1
pkgdesc="High-performance low-poly 3D dogfighting simulator (VCS development version)"
arch=('x86_64' 'aarch64')
url="https://github.com/0x07dc/AirplaneGame"
license=('MIT')
depends=(
    'alsa-lib'
    'vulkan-icd-loader'
    'wayland'
)
makedepends=(
    'git'
    'vulkan-headers'
    'wayland-protocols'
    'zig>=0.13.0'
)
optdepends=(
    'nvidia-utils: NVIDIA Vulkan driver'
    'vulkan-intel: Intel Vulkan driver'
    'vulkan-radeon: AMD Vulkan driver'
)
provides=('airplane-game')
conflicts=('airplane-game')
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd AirplaneGame
    git describe --long --tags --abbrev=7 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' ||
    printf "0.1.1.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
    cd AirplaneGame
    export ZIG_GLOBAL_CACHE_DIR="$srcdir/zig-global-cache"
    export ZIG_LOCAL_CACHE_DIR="$srcdir/zig-local-cache"

    zig build \
        -Doptimize=ReleaseFast \
        -Duse-precompiled-shaders=true
}

package() {
    cd AirplaneGame
    export ZIG_GLOBAL_CACHE_DIR="$srcdir/zig-global-cache"
    export ZIG_LOCAL_CACHE_DIR="$srcdir/zig-local-cache"

    zig build \
        --prefix "$pkgdir/usr" \
        -Doptimize=ReleaseFast \
        -Duse-precompiled-shaders=true

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
