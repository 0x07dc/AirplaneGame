# Maintainer: 0x07dc <voss.jamil@gmail.com>
pkgname=airplane-game
pkgver=0.1.0
pkgrel=1
pkgdesc="High-performance low-poly 3D dogfighting simulator built in Zig, Vulkan 1.3, Wayland, and ALSA"
arch=('x86_64' 'aarch64')
url="https://github.com/0x07dc/AirplaneGame"
license=('MIT')
depends=(
    'alsa-lib'
    'vulkan-icd-loader'
    'wayland'
)
makedepends=(
    'vulkan-headers'
    'wayland-protocols'
    'zig>=0.13.0'
)
optdepends=(
    'nvidia-utils: NVIDIA Vulkan driver'
    'vulkan-intel: Intel Vulkan driver'
    'vulkan-radeon: AMD Vulkan driver'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "AirplaneGame-$pkgver"
    export ZIG_GLOBAL_CACHE_DIR="$srcdir/zig-global-cache"
    export ZIG_LOCAL_CACHE_DIR="$srcdir/zig-local-cache"

    zig build \
        -Doptimize=ReleaseFast \
        -Duse-precompiled-shaders=true
}

package() {
    cd "AirplaneGame-$pkgver"
    export ZIG_GLOBAL_CACHE_DIR="$srcdir/zig-global-cache"
    export ZIG_LOCAL_CACHE_DIR="$srcdir/zig-local-cache"

    zig build \
        --prefix "$pkgdir/usr" \
        -Doptimize=ReleaseFast \
        -Duse-precompiled-shaders=true

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
