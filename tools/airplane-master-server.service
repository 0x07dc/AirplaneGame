[Unit]
Description=Airplane Combat Simulator Master Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/airplane_master_server
ExecStart=/usr/bin/python3 /opt/airplane_master_server/master_server.py --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
